# =============================================================================
# Antigravity ZECTRIX NOTE4 额度预测看板配置
# =============================================================================

# CPA (CLIProxyAPI) Antigravity 登录 JSON 路径（支持单文件或目录自动扫描 antigravity-*.json）
CPA_AUTH_PATH=/var/lib/antigravity-zectrix/antigravity-user.json

# AES-256-GCM 凭证原地加密密钥文件（32 字节或任意高熵口令，配合 /etc/machine-id 派生密钥）
# 留空则不执行原地加密替换（强烈建议生产环境开启）
CACHE_ENCRYPTION_KEY_FILE=/etc/antigravity-zectrix/master.key

# 可选：自定义 OAuth Client ID/Secret（若 CPA JSON 中未携带则回退到此项）
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# 可选：自定义代理地址（用于访问 oauth2.googleapis.com 与 cloudcode-pa.googleapis.com）
HTTP_PROXY_URL=

# 可选：覆盖上游额度接口地址（默认主备自动切换 cloudcode-pa / daily-cloudcode-pa）
ANTIGRAVITY_QUOTA_BASE_URL=https://cloudcode-pa.googleapis.com

# 轮询与刷新周期（秒）
QUOTA_POLL_SECONDS=1800
ANTIGRAVITY_AUTH_REFRESH_SECONDS=3600

# 轮询暂停窗口（HH:MM-HH:MM，逗号分隔；窗口内停止轮询与推送）
QUOTA_PAUSE_WINDOWS=01:00-07:00
TIMEZONE=Asia/Shanghai

# 本地状态与历史快照文件（用于计算消耗速率 %/h、Runway 与底部预测曲线）
STATE_FILE=/var/lib/antigravity-zectrix/state.json
HISTORY_MAX_HOURS=12
STALE_AFTER_SECONDS=5400

# ZECTRIX NOTE4 推送配置
ZECTRIX_BASE_URL=https://cloud.zectrix.com
ZECTRIX_DEVICE_ID=your-device-id
ZECTRIX_API_KEY=your-api-key
ZECTRIX_PAGE_ID=3
ZECTRIX_DITHER=false
MIN_PUSH_INTERVAL_SECONDS=60
