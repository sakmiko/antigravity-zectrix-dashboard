# =============================================================================
# Antigravity ZECTRIX NOTE4 额度预测看板配置 (.env 示例)
# 支持与 config.toml 混用（优先级：系统环境变量 > .env > config.toml > 默认值）
# 守护模式默认开启配置热更新（修改 .env 或 config.toml 后自动生效）
# =============================================================================

# 可选：指定 TOML 配置文件路径（默认自动加载当前目录 config.toml）
CONFIG_FILE=

# CPA (CLIProxyAPI) Antigravity 登录 JSON 路径（严格只读，绝不原地修改或加密）
# 支持单文件或目录自动扫描 antigravity-*.json
CPA_AUTH_PATH=/var/lib/antigravity-zectrix/antigravity-user.json

# 可选：当 CPA_AUTH_PATH 为目录时按邮箱精确匹配账号
CPA_ACCOUNT_EMAIL=

# 独立认证缓存文件（刷新后的 OAuth 令牌存放在此，默认与 STATE_FILE 同目录 auth-cache.json）
AUTH_CACHE_FILE=

# 可选：AES-256-GCM 密钥文件（仅加密 AUTH_CACHE_FILE，绝不触碰 CPA 原文件）
CACHE_ENCRYPTION_KEY_FILE=

# 可选：覆盖内置 Antigravity OAuth Client ID/Secret（CPA JSON 缺失时自动回退内置值）
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# 可选：自定义代理地址（用于访问 oauth2.googleapis.com 与 cloudcode-pa.googleapis.com）
HTTP_PROXY_URL=

# 可选：覆盖上游额度接口地址与 User-Agent
ANTIGRAVITY_QUOTA_BASE_URL=https://cloudcode-pa.googleapis.com
ANTIGRAVITY_USER_AGENT=

# 轮询与刷新周期（支持秒数如 1800 或时长如 30m）
QUOTA_POLL_INTERVAL=30m
AUTH_REFRESH_INTERVAL=50m

# 保活配置（默认关闭，开启后可通过自定义时间定期保活，绝不调用任何模型推理接口）
KEEPALIVE_ENABLED=false
KEEPALIVE_INTERVAL=30m
# 保活模式：token（仅刷新 OAuth Token）| session（OAuth + 轻量 loadCodeAssist 心跳）
KEEPALIVE_MODE=session
KEEPALIVE_RESPECT_PAUSE_WINDOWS=false

# 订阅套餐标识（auto 自动从上游识别 | free | plus | pro | ultra）
ANTIGRAVITY_PLAN_TIER=auto

# 轮询暂停窗口（HH:MM-HH:MM，逗号分隔；窗口内停止轮询与设备推送）
QUOTA_PAUSE_WINDOWS=01:00-07:00
TIMEZONE=Asia/Shanghai

# 本地状态与历史快照文件
STATE_FILE=/var/lib/antigravity-zectrix/state.json
HISTORY_MAX_HOURS=12
STALE_AFTER=90m

# 热更新监控（默认开启，轮询配置文件变化并无缝重置定时器）
HOT_RELOAD_ENABLED=true
HOT_RELOAD_INTERVAL=5s

# ZECTRIX NOTE4 推送配置
ZECTRIX_BASE_URL=https://cloud.zectrix.com
ZECTRIX_DEVICE_ID=your-device-id
ZECTRIX_API_KEY=your-api-key
ZECTRIX_PAGE_ID=1
ZECTRIX_DITHER=false
MIN_PUSH_INTERVAL=60s
